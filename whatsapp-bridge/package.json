{
  "name": "ikr-whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only WhatsApp-bridge voor het IKR-dashboard: leest berichten van actieve chats en bewaart ze in Supabase. Verstuurt nooit iets.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "baileys": "6.7.24",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  }
}

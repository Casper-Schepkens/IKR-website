# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="IKnowRight <contact@iknowright.be>"
# Interne form-notificaties (niet contact@ — self-send bounced). Geen mailbox nodig.
RESEND_NOTIFY_FROM_EMAIL="IKnowRight <forms@iknowright.be>"
IKR_NOTIFY_EMAIL=contact@iknowright.be

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Widget → Settings → Hostname Management moet bevatten:
#   - localhost
#   - ikr-website.vercel.app
#   - iknowright.be
#   - www.iknowright.be
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alleen lokaal: captcha volledig overslaan (niet nodig — dev gebruikt automatisch dummy-keys)
# SKIP_TURNSTILE=true

# OpenAI Ads Measurement Pixel — console logging (default uit / false in productie)
# NEXT_PUBLIC_OAIQ_DEBUG=true

# Weekly analytics digest (Vercel Cron → Resend)
# Cron: ma 07:00 UTC → GET /api/cron/weekly-analytics
# Auth: Authorization: Bearer $CRON_SECRET (Vercel zet dit automatisch als CRON_SECRET bestaat)
CRON_SECRET=
# Read-only Vercel token met toegang tot Web Analytics van dit project
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Alleen nodig bij team-account
# VERCEL_TEAM_ID=team_xxx
IKR_ANALYTICS_REPORT_EMAIL=casper.schepkens@icloud.com

# ─────────────────────────────────────────────────────────────
# IKR Admin (/admin) — zie docs/product/admin-setup.md
# Zonder Supabase-variabelen draait /admin lokaal in demomodus (voorbeelddata).
# ─────────────────────────────────────────────────────────────

# Supabase — database, Google-login en opslag
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side (cron, formulieren → leads, opslag). Nooit NEXT_PUBLIC_ maken.
SUPABASE_SERVICE_ROLE_KEY=

# Wie in /admin mag: @iknowright.be mag altijd. Extra adressen komma-gescheiden
# (ook toevoegen in Supabase-tabel admin_users, zie migratie).
IKR_ADMIN_EMAILS=

# Claude API (alle AI-knoppen). Maak een sleutel op https://platform.claude.com
ANTHROPIC_API_KEY=
# Kleine taken (briefing, samenvatting, mails, draaiboek, vragen, analyse) lopen via de API
# met IKR_AI_MODEL_SMALL (standaard claude-sonnet-5-5). Grote taken (ideeën, uitwerken, decks)
# openen standaard Claude via de connector (abonnement). Alles via API: IKR_AI_ALL_API=true
# IKR_AI_MODEL_SMALL=claude-sonnet-5-5
# IKR_AI_MODEL=claude-opus-5-5
# IKR_AI_ALL_API=true

# Billit — facturen als concept klaarzetten (MyBillit → API-sleutel + PartyID)
BILLIT_API_KEY=
BILLIT_PARTY_ID=
# Sandbox om te testen: https://api.sandbox.billit.be
# BILLIT_API_BASE=https://api.billit.be

# TikTok Display API — videostatistieken per klant (developers.tiktok.com)
# Redirect-URI in de TikTok-app: https://iknowright.be/admin/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Calendar-sync (nog niet geactiveerd in de code — fase 2)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=

# Alleen lokaal/preview: demomodus forceren zonder Supabase (NOOIT in productie)
# IKR_ADMIN_DEMO=true

# Grok-bot (Cursor) voor het uitwerken van ideeën — zie docs/product/admin-setup.md
# GROK_WEBHOOK_URL = de webhook van de Cursor-automation
# GROK_WEBHOOK_SECRET = zelf gekozen lang geheim (wordt meegestuurd als Bearer-token
#   en gebruikt om de terugkoppel-links te ondertekenen)
GROK_WEBHOOK_URL=
GROK_WEBHOOK_SECRET=

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="IKnowRight <contact@iknowright.be>"
# Interne form-notificaties (niet contact@ — self-send bounced). Geen mailbox nodig.
RESEND_NOTIFY_FROM_EMAIL="IKnowRight <forms@iknowright.be>"
IKR_NOTIFY_EMAIL=contact@iknowright.be

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Widget → Settings → Hostname Management moet bevatten:
#   - localhost
#   - ikr-website.vercel.app
#   - iknowright.be
#   - www.iknowright.be
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Alleen lokaal: captcha volledig overslaan (niet nodig — dev gebruikt automatisch dummy-keys)
# SKIP_TURNSTILE=true

# OpenAI Ads Measurement Pixel — console logging (default uit / false in productie)
# NEXT_PUBLIC_OAIQ_DEBUG=true

# Weekly analytics digest (Vercel Cron → Resend)
# Cron: ma 07:00 UTC → GET /api/cron/weekly-analytics
# Auth: Authorization: Bearer $CRON_SECRET (Vercel zet dit automatisch als CRON_SECRET bestaat)
CRON_SECRET=
# Read-only Vercel token met toegang tot Web Analytics van dit project
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Alleen nodig bij team-account
# VERCEL_TEAM_ID=team_xxx
IKR_ANALYTICS_REPORT_EMAIL=casper.schepkens@icloud.com

# ─────────────────────────────────────────────────────────────
# IKR Admin (/admin) — zie docs/product/admin-setup.md
# Login met Google via Supabase. Sales (/admin/sales) is enkel voor casper@iknowright.be.
# Zonder Supabase-variabelen draait /admin lokaal in demomodus (data in het geheugen).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side: leest de Google-koppelingen (tokens). Nooit NEXT_PUBLIC_ maken.
SUPABASE_SERVICE_ROLE_KEY=

# Alleen lokaal/preview: demomodus forceren zonder Supabase (NOOIT in productie)
# IKR_ADMIN_DEMO=true

# Apollo (cold mails-dashboard, enkel lezen): Settings → Integrations → API keys
APOLLO_API_KEY=

# Google (agenda + Meet voor de weekly; later Gmail/Drive). OAuth-client "IKR Dashboard Google-koppeling"
# Redirect: https://iknowright.be/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fireflies (weekly: bot-check en transcript naar de Drive). Fireflies → Integrations → API
FIREFLIES_API_KEY=

# Claude API voor de AI-taken van sales (testweek; zie Instellingen → AI-kosten). Zet ook een limiet in de Console.
ANTHROPIC_API_KEY=
# Standaard via de API (claude-sonnet-5-5). IKR_AI_ENGINE=grokbot: Grokbot voert de taken uit via de connector
# (ai_taken_open / ai_taak_klaarzetten); =worker: een eigen server.
# IKR_AI_MODEL=claude-sonnet-5-5
# IKR_AI_ENGINE=grokbot
# Grok Automation met webhook-trigger: het dashboard port Grokbot bij nieuwe taken.
# GROK_WEBHOOK_URL=
# GROK_WEBHOOK_SECRET=<waarde van de Authorization-header van de Grok-webhook, zonder "Bearer ">

# Grokbot (MCP): https://iknowright.be/api/mcp met header Authorization: Bearer <sleutel>,
# of https://iknowright.be/api/mcp/<sleutel> als de app geen headers kan instellen. Genereer met: openssl rand -hex 32
GROKBOT_API_KEY=

# Financiën: Odoo JSON-2 API (enkel lezen)
ODOO_API_KEY=
# ODOO_URL=https://iknowright.odoo.com
